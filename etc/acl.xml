<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <!-- StockPredict is a top-level sidebar module – lives at admin root -->
                <resource id="AI_StockPredict::stock_predict" title="Stock Predict" sortOrder="80">
                    <resource id="AI_StockPredict::dashboard" title="Dashboard" sortOrder="10"/>
                    <resource id="AI_StockPredict::forecasts" title="Forecasts" sortOrder="20"/>
                    <resource id="AI_StockPredict::alerts" title="Alerts" sortOrder="30"/>
                    <resource id="AI_StockPredict::config" title="Configuration" sortOrder="40"/>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
