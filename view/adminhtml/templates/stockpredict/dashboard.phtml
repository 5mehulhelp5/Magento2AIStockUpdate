declare(strict_types=1);

$stats      = $block->getSummaryStats();
$lastRun    = $block->getLastRun();
$critical   = $block->getCriticalForecasts();
$openAlerts = $block->getOpenAlertsCount();
?>
<div class="stockpredict-dashboard">
    <h2><?= $block->escapeHtml(__('StockPredict — Inventory Forecast Dashboard')) ?></h2>

    <!-- Summary Cards -->
    <div class="stockpredict-summary" style="display:flex;gap:20px;margin:20px 0;">
        <div class="stockpredict-card" style="flex:1;padding:20px;background:#fff;border:1px solid #ccc;border-radius:4px;text-align:center;">
            <div style="font-size:2em;font-weight:bold;color:#333;"><?= (int)$stats['total'] ?></div>
            <div style="color:#666;"><?= $block->escapeHtml(__('Total SKUs Monitored')) ?></div>
        </div>
        <div class="stockpredict-card" style="flex:1;padding:20px;background:#fff;border:2px solid #e22626;border-radius:4px;text-align:center;">
            <div style="font-size:2em;font-weight:bold;color:#e22626;"><?= (int)$stats['critical'] ?></div>
            <div style="color:#e22626;"><?= $block->escapeHtml(__('Critical')) ?></div>
        </div>
        <div class="stockpredict-card" style="flex:1;padding:20px;background:#fff;border:2px solid #e07f00;border-radius:4px;text-align:center;">
            <div style="font-size:2em;font-weight:bold;color:#e07f00;"><?= (int)$stats['warning'] ?></div>
            <div style="color:#e07f00;"><?= $block->escapeHtml(__('Warning')) ?></div>
        </div>
        <div class="stockpredict-card" style="flex:1;padding:20px;background:#fff;border:2px solid #d4b800;border-radius:4px;text-align:center;">
            <div style="font-size:2em;font-weight:bold;color:#d4b800;"><?= (int)$stats['watch'] ?></div>
            <div style="color:#d4b800;"><?= $block->escapeHtml(__('Watch')) ?></div>
        </div>
        <div class="stockpredict-card" style="flex:1;padding:20px;background:#fff;border:2px solid #555;border-radius:4px;text-align:center;">
            <div style="font-size:2em;font-weight:bold;color:#333;"><?= (int)$openAlerts ?></div>
            <div style="color:#555;">
                <a href="<?= $block->escapeUrl($block->getAlertsUrl()) ?>" style="color:#555;text-decoration:underline;">
                    <?= $block->escapeHtml(__('Open Alerts')) ?>
                </a>
            </div>
        </div>
    </div>

    <!-- Critical / Warning SKU Table -->
    <?php if ($critical->getSize() > 0): ?>
    <h3><?= $block->escapeHtml(__('Top Critical & Warning SKUs')) ?></h3>
    <table class="data-grid" style="width:100%;border-collapse:collapse;margin-bottom:20px;">
        <thead>
            <tr>
                <th style="padding:8px;border:1px solid #ddd;background:#f5f5f5;"><?= $block->escapeHtml(__('SKU')) ?></th>
                <th style="padding:8px;border:1px solid #ddd;background:#f5f5f5;"><?= $block->escapeHtml(__('Product Name')) ?></th>
                <th style="padding:8px;border:1px solid #ddd;background:#f5f5f5;"><?= $block->escapeHtml(__('Severity')) ?></th>
                <th style="padding:8px;border:1px solid #ddd;background:#f5f5f5;"><?= $block->escapeHtml(__('Current Stock')) ?></th>
                <th style="padding:8px;border:1px solid #ddd;background:#f5f5f5;"><?= $block->escapeHtml(__('Days Until Stockout')) ?></th>
                <th style="padding:8px;border:1px solid #ddd;background:#f5f5f5;"><?= $block->escapeHtml(__('Recommended Reorder Qty')) ?></th>
                <th style="padding:8px;border:1px solid #ddd;background:#f5f5f5;"><?= $block->escapeHtml(__('AI Recommendation')) ?></th>
            </tr>
        </thead>
        <tbody>
        <?php foreach ($critical as $forecast): ?>
            <?php
            $severity      = (string)$forecast->getData('severity');
            $rowColor      = '#fff';
            $severityLabel = strtoupper($severity);
            $severityStyle = 'color:#333;';
            if ($severity === 'critical') {
                $rowColor      = '#fff5f5';
                $severityStyle = 'color:#e22626;font-weight:bold;';
            } elseif ($severity === 'warning') {
                $rowColor      = '#fff8ee';
                $severityStyle = 'color:#e07f00;font-weight:bold;';
            }
            ?>
            <tr style="background:<?= $rowColor ?>">
                <td style="padding:8px;border:1px solid #ddd;"><?= $block->escapeHtml((string)$forecast->getData('sku')) ?></td>
                <td style="padding:8px;border:1px solid #ddd;"><?= $block->escapeHtml((string)$forecast->getData('product_name')) ?></td>
                <td style="padding:8px;border:1px solid #ddd;<?= $severityStyle ?>"><?= $block->escapeHtml($severityLabel) ?></td>
                <td style="padding:8px;border:1px solid #ddd;"><?= $block->escapeHtml(number_format((float)$forecast->getData('current_qty'), 2)) ?></td>
                <td style="padding:8px;border:1px solid #ddd;"><?= $forecast->getData('days_until_stockout') !== null ? (int)$forecast->getData('days_until_stockout') : $block->escapeHtml(__('N/A')) ?></td>
                <td style="padding:8px;border:1px solid #ddd;"><?= $forecast->getData('recommended_reorder_qty') !== null ? $block->escapeHtml(number_format((float)$forecast->getData('recommended_reorder_qty'), 0)) : '—' ?></td>
                <td style="padding:8px;border:1px solid #ddd;font-size:0.9em;color:#555;"><?= $forecast->getData('ai_recommendation') ? $block->escapeHtml((string)$forecast->getData('ai_recommendation')) : '<em>' . $block->escapeHtml(__('—')) . '</em>' ?></td>
            </tr>
        <?php endforeach; ?>
        </tbody>
    </table>
    <p>
        <a href="<?= $block->escapeUrl($block->getForecastsUrl()) ?>" class="action-default scalable">
            <?= $block->escapeHtml(__('View All Forecasts')) ?>
        </a>
    </p>
    <?php else: ?>
    <p><?= $block->escapeHtml(__('No critical or warning SKUs detected. All stock levels are healthy.')) ?></p>
    <?php endif; ?>

    <!-- Last Run Info -->
    <div style="margin-top:30px;padding:12px;background:#f9f9f9;border:1px solid #e0e0e0;border-radius:4px;">
        <strong><?= $block->escapeHtml(__('Last Forecast Run:')) ?></strong>
        <?php if ($lastRun): ?>
            <?= $block->escapeHtml(__('Run #%1 — Status: %2 — SKUs Analyzed: %3 — Completed: %4', $lastRun->getId(), strtoupper((string)$lastRun->getData('status')), (int)$lastRun->getData('skus_analyzed'), (string)($lastRun->getData('completed_at') ?: __('N/A')))) ?>
        <?php else: ?>
            <?= $block->escapeHtml(__('No forecast runs found. Run the cron or use the CLI: php bin/magento ai:stockai:forecast')) ?>
        <?php endif; ?>
    </div>
</div>
